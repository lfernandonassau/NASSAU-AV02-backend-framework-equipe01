generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//
// ─────────────────────────── MODELOS DO SISTEMA ───────────────────────────
//

// Usuário do sistema (login)
model Usuario {
  id_usuario Int      @id @default(autoincrement())
  nome       String   @db.VarChar(50)
  email      String   @unique @db.VarChar(100)
  senha      String   @db.VarChar(255)
  criado_em  DateTime @default(now())

  // Relação 1:1 com Jogador
  jogador    Jogador?
}

// Jogador do Clash Royale vinculado ao usuário
model Jogador {
  id_jogador Int      @id @default(autoincrement())
  clash_id   String   @unique @db.VarChar(18)     // Tag do jogador (#XXXXX)
  nome       String   @db.VarChar(50)
  nivel      Int
  trofeus    Int
  pais       String?  @db.VarChar(10)             // Código do país (opcional)

  // Relação 1:1 com Usuario
  id_usuario Int      @unique
  usuario    Usuario  @relation(fields: [id_usuario], references: [id_usuario])

  // Relações com outras entidades
  decks       Deck[]
  estatistica Estatistica_Jogador?
  logs        Log_Acao[]

  // Relações com partidas (jogador 1 e jogador 2)
  partidas1   Partida[] @relation("Jogador1")
  partidas2   Partida[] @relation("Jogador2")

  // Relação com torneios
  torneios    Torneio_Jogador[]
}

// Deck pertencente ao jogador
model Deck {
  id_deck    Int       @id @default(autoincrement())
  nome       String    @db.VarChar(50)

  id_jogador Int
  jogador    Jogador   @relation(fields: [id_jogador], references: [id_jogador])

  // Cartas pertencentes ao deck (relação N:N)
  cartas     Deck_Carta[]
}

// Carta existente no jogo
model Carta {
  id_carta     Int          @id @default(autoincrement())
  nome         String       @db.VarChar(50)
  tipo         String       @db.VarChar(30)
  raridade     String       @db.VarChar(20)
  elixir       Int
  nivel_maximo Int

  // Relação N:N com Deck (via pivot Deck_Carta)
  decks        Deck_Carta[]
}

// Pivot N:N entre Deck e Carta
model Deck_Carta {
  id_deck     Int
  id_carta    Int
  nivel_carta Int            // Nível da carta específica no deck

  deck  Deck  @relation(fields: [id_deck], references: [id_deck])
  carta Carta @relation(fields: [id_carta], references: [id_carta])

  @@id([id_deck, id_carta])
}

// Partidas registradas entre jogadores
model Partida {
  id_partida  Int      @id @default(autoincrement())
  data_hora   DateTime @default(now())
  resultado   String   @db.VarChar(20)

  // Duração em segundos (mais adequado e leve que DateTime)
  duracao     Int      

  id_jogador1 Int
  id_jogador2 Int
  id_arena    Int

  jogador1 Jogador @relation("Jogador1", fields: [id_jogador1], references: [id_jogador])
  jogador2 Jogador @relation("Jogador2", fields: [id_jogador2], references: [id_jogador])
  arena    Arena   @relation(fields: [id_arena], references: [id_arena])
}

// Arena do Clash Royale
model Arena {
  id_arena           Int        @id @default(autoincrement())
  nome               String     @db.VarChar(50)
  nivel_minimo       Int
  trofeus_requeridos Int

  // Partidas realizadas nessa arena
  partidas           Partida[]
}

// Torneios registrados
model Torneio {
  id_torneio  Int               @id @default(autoincrement())
  nome        String            @db.VarChar(50)
  premiacao   String            @db.VarChar(100)
  data_inicio DateTime
  data_fim    DateTime

  jogadores   Torneio_Jogador[]
}

// Pivot entre Torneio e Jogador (participação)
model Torneio_Jogador {
  id_torneio Int
  id_jogador Int
  colocacao  Int
  pontuacao  Int

  torneio Torneio @relation(fields: [id_torneio], references: [id_torneio])
  jogador Jogador @relation(fields: [id_jogador], references: [id_jogador])

  @@id([id_torneio, id_jogador])
}

// Estatísticas agregadas do jogador
model Estatistica_Jogador {
  id_estatistica Int     @id @default(autoincrement())
  id_jogador     Int     @unique
  vitorias       Int
  derrotas       Int
  empates        Int
  taxa_vitoria   Float

  jogador Jogador @relation(fields: [id_jogador], references: [id_jogador])
}

// Log de ações do jogador (histórico)
model Log_Acao {
  id_log     Int      @id @default(autoincrement())
  id_jogador Int
  acao       String   @db.VarChar(50)      // Tipo da ação
  data_hora  DateTime @default(now())
  detalhes   String   @db.VarChar(255)

  jogador    Jogador  @relation(fields: [id_jogador], references: [id_jogador])
}
